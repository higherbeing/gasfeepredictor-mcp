{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.higherbeing/gasfeepredictor-mcp",
  "title": "Gas Fee Predictor",
  "description": "Live Ethereum and L2 gas fees: current gas, cheapest L2, forecast, ETH price, cost estimates.",
  "version": "1.1.0",
  "websiteUrl": "https://gasfeepredictor.com/docs/api",
  "repository": {
    "url": "https://github.com/higherbeing/gasfeepredictor-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://api.gasfeepredictor.com/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": ["180x180"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.gasfeepredictor.com/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "gasfeepredictor-mcp",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
